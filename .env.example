# --- フロントエンド（Vercel環境変数 / ローカル .env.local）---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Gmail取り込み（GitHub Actions Secrets / ローカルテスト用 .env.local）---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Supabase書き込み用（GitHub Actions Secrets と、Vercel環境変数の両方に必要。ブラウザに絶対渡さない）---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 分類ルール管理画面のロック用合言葉（Vercel環境変数のみ）---
ADMIN_SECRET=
